# Node Environment
NODE_ENV=development

# Server Port
PORT=3000

# CORS Origins - Comma-separated list of allowed domains
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# API key gate for /api/* and /output/* media
# REQUIRED when NODE_ENV=production (server will refuse to start without it)
# Leave empty only for local development
# Clients must send X-API-Key, Authorization: Bearer <key>, or (GET downloads) ?api_key=
API_KEY=

# Optional comma-separated host allowlist for meeting/calendly links (empty = any http/https)
MEETING_LINK_ALLOWED_HOSTS=

# API Keys - Get your key from https://platform.openai.com
OPENAI_API_KEY=your_openai_api_key_here

# Primary chat model (default: gpt-4o-mini)
MODEL_NAME=gpt-4o-mini

# Optional per-feature model overrides
# OPENAI_INTERVIEW_MODEL=gpt-4o-mini
# OPENAI_EVALUATION_MODEL=gpt-4o-mini
# OPENAI_PODCAST_SCRIPT_MODEL=gpt-4o-mini
# OPENAI_VOICE_EVALUATION_MODEL=gpt-4o-mini

# HuggingFace (optional fallback for timeout / quota / 5xx — not used for invalid API keys)
HF_TOKEN=your_huggingface_token_here
HF_MODEL=mistralai/Mistral-Nemo-Instruct-2407
HF_BASE_URL=https://router.huggingface.co/v1

# Email Configuration - For sending evaluations and reports
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
# Optional SMTP overrides (defaults: smtp.gmail.com:587, secure=false)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
# Shown in invitation / reminder emails
RECRUITER_CONTACT=recruiter@your-company.com
CALENDLY_LINK=https://calendly.com/your-company/interview

# Frontend base URL used to build interview meeting links
FRONTEND_URL=http://localhost:4200

# Directory Configurations
UPLOAD_DIR=uploads/
OUTPUT_DIR=output
REPORT_DIR=results
# Private data dir for interviews.json (not publicly served)
DATA_DIR=data

# Interview reminder scheduler (in-process; also triggerable via POST /api/interviews/reminders/process)
# Format: key:minutesBefore,...  Production default: 24h / 1h / 30m / 10m
REMINDER_WINDOWS=24h:1440,1h:60,30m:30,10m:10
# Poll interval in ms (minimum 5000). Default 60000.
REMINDER_CHECK_INTERVAL_MS=60000
# Local testing example (schedule interview ~5 minutes ahead):
# REMINDER_WINDOWS=24h:4,1h:2,30m:1,10m:1
# REMINDER_CHECK_INTERVAL_MS=15000

# Overall score threshold for Selected vs Rejected (default 80)
# EVALUATION_SELECTED_THRESHOLD=80
