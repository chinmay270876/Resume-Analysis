# Node Environment
NODE_ENV=development

# Server Port
PORT=3000

# CORS Origins - Comma-separated list of allowed domains
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# API key gate for /api/* and /output/* media
# REQUIRED when NODE_ENV=production (server will refuse to start without it)
# Leave empty only for local development
# Clients must send X-API-Key, Authorization: Bearer <key>, or (GET downloads) ?api_key=
API_KEY=

# Optional comma-separated host allowlist for meeting/calendly links (empty = any http/https)
MEETING_LINK_ALLOWED_HOSTS=

# API Keys - Get your key from https://platform.openai.com
OPENAI_API_KEY=your_openai_api_key_here

# Primary chat model (default: gpt-4o-mini)
MODEL_NAME=gpt-4o-mini

# Optional per-feature model overrides
# OPENAI_INTERVIEW_MODEL=gpt-4o-mini
# OPENAI_EVALUATION_MODEL=gpt-4o-mini
# OPENAI_PODCAST_SCRIPT_MODEL=gpt-4o-mini
# OPENAI_VOICE_EVALUATION_MODEL=gpt-4o-mini

# HuggingFace (optional fallback for timeout / quota / 5xx — not used for invalid API keys)
HF_TOKEN=your_huggingface_token_here
HF_MODEL=mistralai/Mistral-Nemo-Instruct-2407
HF_BASE_URL=https://router.huggingface.co/v1

# Email Configuration - For sending evaluations, invitations, and reminders
# Production (Render): Gmail SMTP via Nodemailer. Connections use IPv4 (family=4)
# because Render cannot reach Gmail's IPv6 SMTP addresses (ENETUNREACH).
# EMAIL_PROVIDER=gmail is the supported production path. Do not switch to Resend
# unless you explicitly opt in.
EMAIL_PROVIDER=gmail
RESEND_API_KEY=
# Optional display From header. Gmail SMTP falls back to EMAIL_USER when unset.
EMAIL_FROM=Resume Evaluator <your_email@gmail.com>
# Gmail SMTP (required for invitations/reminders). Use an App Password when 2FA is enabled.
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
# Optional SMTP overrides (defaults: smtp.gmail.com:587, STARTTLS).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
# Shown in invitation / reminder emails
RECRUITER_CONTACT=recruiter@your-company.com
CALENDLY_LINK=https://calendly.com/your-company/interview

# Frontend base URL used to build candidate interview meeting links
# Links are always /candidate-interview/:id (not /interviews/:id)
FRONTEND_URL=http://localhost:4200
# Production example:
# FRONTEND_URL=https://resume-analysis-b7p7.onrender.com
# NODE_ENV=production
# CORS_ORIGINS=https://resume-analysis-b7p7.onrender.com
# API_KEY=generate-a-long-random-secret
#
# Render notes:
# - Attach a persistent disk for data/, results/, uploads/, output/ or data is lost on redeploy.
# - Free web services sleep; schedule Cron to POST /api/interviews/reminders/process (with X-API-Key if set).
# - Use the live Node host (e.g. resume-analysis-api-so26.onrender.com), not a misconfigured Python service.

# 100ms.live — per-interview voice rooms (Developer section of the 100ms dashboard)
# Never commit real secrets. Never expose HMS_APP_SECRET or HMS_WEBHOOK_SECRET to Angular.
HMS_APP_ACCESS_KEY=
HMS_APP_SECRET=
HMS_TEMPLATE_ID=
HMS_WEBHOOK_SECRET=
HMS_REGION=in
HMS_ROLE_INTERVIEWER=interviewer
HMS_ROLE_STUDENT=student
HMS_ROLE_ADMIN=host
# Optional public API URL used when attaching a room-level webhook (Render sets RENDER_EXTERNAL_URL)
# BACKEND_PUBLIC_URL=https://your-api.onrender.com
# Legacy aliases still accepted: 100MS_ACCESS_KEY / 100MS_SECRET / 100MS_ROOM_ID
# Directory Configurations
UPLOAD_DIR=uploads/
OUTPUT_DIR=output
REPORT_DIR=results
# Private data dir for interviews.json (not publicly served)
DATA_DIR=data

# Interview reminder scheduler (in-process; also triggerable via POST /api/interviews/reminders/process)
# Format: key:minutesBefore,...  Production default: 24h / 1h / 30m / 10m
REMINDER_WINDOWS=24h:1440,1h:60,30m:30,10m:10
# Poll interval in ms (minimum 5000). Default 60000.
REMINDER_CHECK_INTERVAL_MS=60000
# Local testing example (schedule interview ~5 minutes ahead):
# REMINDER_WINDOWS=24h:4,1h:2,30m:1,10m:1
# REMINDER_CHECK_INTERVAL_MS=15000

# Overall score threshold for Selected vs Rejected (default 80)
# EVALUATION_SELECTED_THRESHOLD=80
